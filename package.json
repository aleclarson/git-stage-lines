    "@types/node": "^25.6.0",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "tsdown": "^0.21.10",
    "tsnapi": "^0.3.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
